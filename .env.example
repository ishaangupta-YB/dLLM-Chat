# Server-only. Never prefix with NEXT_PUBLIC_.
INCEPTION_API_KEY=
# Legacy name, also accepted:
# DLLM_API_KEY=
# Optional: enterprise Mercury Voice model id. Voice mode falls back to mercury-3 + realtime.
# MERCURY_VOICE_MODEL=
# Optional: extra allowed origins for the API routes (comma separated).
# ALLOWED_ORIGINS=https://dllmchat.vercel.app
# Optional: override the API base URL.
# INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
